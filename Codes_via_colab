# 1. INSTALL & IMPORT
# ============================================================
!pip install geemap earthengine-api

import ee
import geemap
import numpy as np
import matplotlib.pyplot as plt
import pandas as pd

ee.Authenticate()
ee.Initialize(project='ee-imranak32ab')


# ============================================================
# 2. REGION OF INTEREST (NORTHERN ARABIAN SEA)
# ============================================================
roi = ee.Geometry.Polygon([
    [[60.8383, 19.4404],
     [71.4731, 19.4404],
     [71.4731, 25.7649],
     [60.8383, 25.7649],
     [60.8383, 19.4404]]
])


# ============================================================
# 3. DATA (MODIS AQUA 2016)
# ============================================================
dataset = ee.ImageCollection("NASA/OCEANDATA/MODIS-Aqua/L3SMI") \
    .filterDate("2016-01-01", "2016-12-31") \
    .filterBounds(roi)

img = dataset.mean().clip(roi)

chl  = img.select("chlor_a")
sst  = img.select("sst")
nflh = img.select("nflh")
poc  = img.select("poc")


# ============================================================
# 4. TRAINING DATA
# ============================================================
combined = img

sample = combined.sample(
    region=roi,
    scale=4000,
    numPixels=10000,
    geometries=True
).randomColumn("random")

sample = sample.filter(ee.Filter.lt("chlor_a", 5))

train = sample.filter(ee.Filter.lte("random", 0.8))
test  = sample.filter(ee.Filter.gt("random", 0.8))

bands = ["nflh", "poc", "sst"]


# ============================================================
# 5. RANDOM FOREST MODEL (REGRESSION)
# ============================================================
rf = ee.Classifier.smileRandomForest(
    numberOfTrees=100,
    variablesPerSplit=None,
    minLeafPopulation=1,
    bagFraction=0.7,
    seed=42
).setOutputMode("REGRESSION") \
    .train(train, "chlor_a", bands)

# ============================================================
# 6. PREDICTION
# ============================================================
predicted = img.classify(rf, "pred").clip(roi)


# ============================================================
# 7. CONVERT TO NUMPY
# ============================================================
def to_array(image):
    return geemap.ee_to_numpy(image, region=roi, scale=4000)

chl_arr  = to_array(chl)
sst_arr  = to_array(sst)
nflh_arr = to_array(nflh)
poc_arr  = to_array(poc)
pred_arr = to_array(predicted)


extent = [60.8383, 71.4731, 19.4404, 25.7649]


def add_latlon(ax):
    ax.set_xticks(np.linspace(0, chl_arr.shape[1], 5))
    ax.set_yticks(np.linspace(0, chl_arr.shape[0], 5))
    ax.set_xticklabels(np.round(np.linspace(extent[0], extent[1], 5), 2))
    ax.set_yticklabels(np.round(np.linspace(extent[2], extent[3], 5), 2))
    ax.set_xlabel("Longitude")
    ax.set_ylabel("Latitude")


# ============================================================
# 8. PAPER MAPS
# ============================================================
fig, axs = plt.subplots(2, 3, figsize=(18, 10))

axs[0,0].imshow(chl_arr, cmap="viridis"); axs[0,0].set_title("Chl-a"); add_latlon(axs[0,0])
axs[0,1].imshow(sst_arr, cmap="plasma");  axs[0,1].set_title("SST"); add_latlon(axs[0,1])
axs[0,2].imshow(nflh_arr, cmap="turbo");  axs[0,2].set_title("NFLH"); add_latlon(axs[0,2])

axs[1,0].imshow(poc_arr, cmap="cividis"); axs[1,0].set_title("POC"); add_latlon(axs[1,0])
im = axs[1,1].imshow(pred_arr, cmap="jet"); axs[1,1].set_title("Predicted Chl-a"); add_latlon(axs[1,1])

axs[1,2].axis("off")

plt.colorbar(im, ax=axs[1,1])
plt.tight_layout()
plt.show()


# ============================================================
# 9. ACCURACY METRICS (RMSE, R², MAE)
# ============================================================
test_pred = test.classify(rf, "pred").getInfo()["features"]

y_true = np.array([f["properties"]["chlor_a"] for f in test_pred])
y_pred = np.array([f["properties"]["pred"] for f in test_pred])

rmse = np.sqrt(np.mean((y_true - y_pred)**2))
mae  = np.mean(np.abs(y_true - y_pred))
r2   = np.corrcoef(y_true, y_pred)[0,1]**2

print("RMSE:", rmse)
print("MAE:", mae)
print("R²:", r2)


# ============================================================
# 10. GRAPHICAL CORRELATION
# ============================================================
min_val = min(y_true.min(), y_pred.min())
max_val = max(y_true.max(), y_pred.max())

fig, ax = plt.subplots(figsize=(7,7))

ax.scatter(y_true, y_pred, s=12, alpha=0.5)
ax.plot([min_val, max_val], [min_val, max_val], "r--")

ax.set_xlabel("Observed Chl-a")
ax.set_ylabel("Predicted Chl-a")
ax.set_title("Observed vs Predicted")

plt.tight_layout()
plt.show()


# ============================================================
# 11. RESIDUAL ANALYSIS
# ============================================================
residuals = y_pred - y_true

fig, ax = plt.subplots(figsize=(7,5))

ax.scatter(y_pred, residuals, s=10)
ax.axhline(0, color="red", linestyle="--")

ax.set_title("Residual Analysis")
ax.set_xlabel("Predicted")
ax.set_ylabel("Residual")

plt.tight_layout()
plt.show()


# ============================================================
# 12. ERROR DISTRIBUTION
# ============================================================
fig, ax = plt.subplots(figsize=(7,5))

ax.hist(residuals, bins=30)
ax.set_title("Error Distribution")
ax.set_xlabel("Error")
ax.set_ylabel("Frequency")

plt.tight_layout()
plt.show()


# ============================================================
# 13. SPATIAL ERROR MAP (FIXED)
# ============================================================

fc = test.classify(rf)  # produces "classification"

def add_error(f):
    pred = ee.Number(f.get("classification"))
    obs  = ee.Number(f.get("chlor_a"))

    error = pred.subtract(obs)

    return f.set("error", error)

error_fc = fc.map(add_error)

error_img = error_fc.reduceToImage(
    properties=["error"],
    reducer=ee.Reducer.mean()
).clip(roi)

error_arr = geemap.ee_to_numpy(error_img, region=roi, scale=4000)

fig, ax = plt.subplots(figsize=(7,6))
im = ax.imshow(error_arr, cmap="RdBu", vmin=-2, vmax=2)
ax.set_title("Spatial Error Map")
plt.colorbar(im, ax=ax)
plt.show()

# ============================================================
# 14. FEATURE IMPORTANCE
# ============================================================
importance = rf.explain().getInfo()["importance"]

imp_df = pd.DataFrame({
    "Variable": list(importance.keys()),
    "Importance": list(importance.values())
}).sort_values("Importance")

fig, ax = plt.subplots(figsize=(7,5))
ax.barh(imp_df["Variable"], imp_df["Importance"])
ax.set_title("Feature Importance")
plt.tight_layout()
plt.show()


# ============================================================
# 15. UNCERTAINTY MAP (RF PROXY)
# ============================================================
uncertainty = combined.classify(rf).reduceNeighborhood(
    reducer=ee.Reducer.stdDev(),
    kernel=ee.Kernel.square(3)
).clip(roi)

uncert_arr = geemap.ee_to_numpy(uncertainty, region=roi, scale=4000)

fig, ax = plt.subplots(figsize=(7,6))

im = ax.imshow(uncert_arr, cmap="magma")
ax.set_title("Prediction Uncertainty")

plt.colorbar(im, ax=ax)
plt.show()


